# NestJS API (una-mart-backend). The browser calls it directly with cookies,
# so it must be same-site with the storefront (localhost:4000 in dev,
# api.unamartbd.com in production).
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Optional: a private URL server components use to reach the API (e.g. on
# the hosting network). Defaults to NEXT_PUBLIC_API_URL.
# API_URL=
# Public origin used for canonical URLs, sitemap.xml, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.unamartbd.com
